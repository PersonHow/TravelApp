// Prisma Schema — Travel App 後端資料模型
// 命名規範：資料表 PascalCase、欄位 camelCase、關聯欄位 = 對應表名 + Id
// 修改後必跑：npx prisma migrate dev --name "說明" && npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 家庭成員角色
enum FamilyRole {
  OWNER // 建立者
  ADMIN // 管理員
  MEMBER // 一般成員
}

// 使用者
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String // 認證用（密碼雜湊後存放，搭配 JWT）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  familyMembers FamilyMember[]
}

// 家庭群組
model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members FamilyMember[]
  trips   Trip[]
}

// 使用者與家庭的多對多關聯（join table）
model FamilyMember {
  id       String     @id @default(cuid())
  userId   String
  familyId String
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId]) // 同一人在同一家庭只會有一筆
}

// 行程
model Trip {
  id        String   @id @default(cuid())
  title     String
  startDate DateTime
  endDate   DateTime
  familyId  String
  // 目的地(如「日本・東京」),給 AI 判斷當地語言與地區,生成短句/排行程用
  destination String?
  // 幣別與匯率(設計檔顯示「¥600 ≈ NT$126」需要這兩個欄位)
  currency  String?  // ISO 4217 例如 "JPY"、"KRW"
  symbol    String?  // 顯示符號 例如 "¥"、"₩"
  fx        Float?   // 1 currency ≈ X TWD,手動填(之後可接匯率 API)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tripAttractions TripAttraction[]
  tripDays        TripDay[]
  hotels          Hotel[]
  flights         Flight[]
  packingItems    PackingItem[]
  phrases         Phrase[]
}

// 景點（可被多個行程共用，資料可來自 Google Places）
model Attraction {
  id        String   @id @default(cuid())
  name      String
  address   String?
  lat       Float?
  lng       Float?
  placeId   String?  @unique // Google Places place_id
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripAttractions TripAttraction[]
  dayActivities   DayActivity[]
}

// 行程與景點的多對多關聯（join table）
model TripAttraction {
  id           String   @id @default(cuid())
  tripId       String
  attractionId String
  order        Int      @default(0) // 在行程中的排序
  note         String?
  createdAt    DateTime @default(now())

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@unique([tripId, attractionId])
}

// 行程中的某一天
model TripDay {
  id        String   @id @default(cuid())
  tripId    String
  date      DateTime
  dayNumber Int // 第幾天（1, 2, 3...）
  theme     String? // 該日主題,例如 "淺草・上野"（給設計檔的 column header）
  createdAt DateTime @default(now())

  trip       Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities DayActivity[]

  @@unique([tripId, dayNumber])
}

// 每日活動
model DayActivity {
  id           String    @id @default(cuid())
  tripDayId    String
  title        String
  startTime    DateTime?
  endTime      DateTime?
  attractionId String? // 可選：關聯到某景點
  note         String?
  order        Int       @default(0)
  // 設計檔顯示需要的欄位
  type         String? // "spot" | "food" | "shop" | "move" — 類別,影響顏色徽章
  place        String? // 地點/區域,例如 "台東区浅草"（短字串,跟 Attraction 的詳細地址不同）
  hours        String? // 營業時間區間,自由字串例如 "06:00–17:00"
  price        Int? // 票價/消費,單位看所屬 Trip.currency（整數,0 = 免費）
  // 精確位置(景點搜尋帶入時一併存,給「開啟地圖」與之後的內嵌地圖 pin 用)
  placeId      String? // Google Places place_id
  lat          Float?
  lng          Float?
  createdAt    DateTime  @default(now())

  tripDay    TripDay     @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  attraction Attraction? @relation(fields: [attractionId], references: [id], onDelete: SetNull)
}

// 飯店
model Hotel {
  id         String   @id @default(cuid())
  tripId     String
  name       String
  address    String?
  lat        Float?
  lng        Float?
  checkIn    DateTime
  checkOut   DateTime
  bookingRef String? // 訂房代號
  createdAt  DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// 航班
model Flight {
  id               String   @id @default(cuid())
  tripId           String
  flightNumber     String
  airline          String?
  departureAirport String // IATA 代碼，如 TPE
  arrivalAirport   String // 如 NRT
  departureTime    DateTime
  arrivalTime      DateTime
  aircraft         String? // 機型,例如 "A350-900"
  accessNote       String? // 前往機場方式備註(自由文字,航班詳細頁顯示)
  createdAt        DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// 旅遊短句(AI 生成,跟著 Trip、cascade 刪除;全家共用同一份,生成一次不重複計費)
model Phrase {
  id        String   @id @default(cuid())
  tripId    String
  category  String // "greeting" | "dining" | "transport" | "shopping" | "emergency"
  text      String // 當地語言原文
  reading   String? // 讀法(羅馬拼音等,無法標注時為空)
  meaning   String // 中文意思
  order     Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// 行李清單項目(跟著 Trip,在航班詳細頁顯示與勾選)
model PackingItem {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
