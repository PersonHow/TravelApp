# 後端環境變數範本 — 複製成 apps/api/.env 後填入
# ⚠️ .env 不可 commit

# PostgreSQL 連線字串（對應根目錄 docker-compose.yml 的本機 DB）
DATABASE_URL=postgresql://travel:travel_dev_password@localhost:5432/travel_app

# JWT 密鑰（本機隨意填，正式環境走 GCP Secret Manager）
JWT_SECRET=change_me_in_local

# 伺服器埠號
PORT=3000

# ── 第三方 API（之後串接才需要，本機先留空）──
# AVIATION_STACK_API_KEY=
# GOOGLE_PLACES_API_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY=
# ── AI 生成（旅遊短句等；未設定時相關端點回 503）──
# 到 console.anthropic.com 申請；開發期可填 mock 跳過真實呼叫
# ANTHROPIC_API_KEY=
# 預設 claude-haiku-4-5，要換模型才需要設
# ANTHROPIC_MODEL=
