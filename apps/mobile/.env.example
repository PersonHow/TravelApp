# 後端 API base URL
# iOS Simulator 用 localhost、Android Emulator 用 10.0.2.2、實機請改成 Mac 的區網 IP
EXPO_PUBLIC_API_URL=http://localhost:3000
# Web 瀏覽器金鑰，只允許正式 Web 網域（或本機開發來源）使用 Maps JavaScript API。
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# 原生 build 使用平台專用金鑰，勿與 Web 或後端金鑰共用。
# GOOGLE_MAPS_IOS_API_KEY=
# GOOGLE_MAPS_ANDROID_API_KEY=
# 正式 Web 公開頁面必填
# EXPO_PUBLIC_OPERATOR_NAME=
# EXPO_PUBLIC_SUPPORT_EMAIL=
