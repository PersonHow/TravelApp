# ── Travel App 環境變數範本 ───────────────────────────────
# 各 app 有各自的 .env，這裡彙整方便查閱。
# 實際使用請複製到對應位置：
#   apps/api/.env       後端
#   apps/mobile/.env    前端（之後建立）
# ⚠️ 切勿 commit 真正的 .env，只 commit 本範本檔

# === 後端 (apps/api/.env) ===
DATABASE_URL=postgresql://travel:travel_dev_password@localhost:5432/travel_app
JWT_SECRET=change_me_in_local
PORT=3000
# 第三方（之後串接才需要）
# AVIATION_STACK_API_KEY=
# GOOGLE_PLACES_API_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY=
# ── AI 生成（旅遊短句等；未設定時相關端點回 503）──
# 到 console.anthropic.com 申請；開發期可填 mock 跳過真實呼叫
# ANTHROPIC_API_KEY=
# 預設 claude-haiku-4-5，要換模型才需要設
# ANTHROPIC_MODEL=

# === 前端 (apps/mobile/.env)（之後建立）===
# 真機測試：localhost 改成你 Mac 的區網 IP（用 `ipconfig getifaddr en0` 查）
# EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
